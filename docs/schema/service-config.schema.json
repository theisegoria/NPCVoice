{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "npc_service_create config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "queueCapacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295,
      "default": 16
    },
    "cacheCapacity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "default": 256
    },
    "cancelGraceMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "default": 300
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metaPhrases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Replaces the built-in fourth-wall phrases."
        },
        "extraMetaPhrases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minJapaneseScriptFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
